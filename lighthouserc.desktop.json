{
  "ci": {
    "collect": {
      "url": [
        "https://itfriday.community/",
        "https://itfriday.community/streams/",
        "https://itfriday.community/streams/022",
        "https://itfriday.community/en/",
        "https://itfriday.community/en/streams/",
        "https://itfriday.community/en/streams/022"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new",
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "warn",
          {
            "maxNumericValue": 0.1
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lighthouse-results/desktop"
    }
  }
}
