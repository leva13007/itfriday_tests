{
  "name": "itfriday-testing",
  "version": "0.1.0",
  "private": true,
  "description": "Automated tests for https://itfriday.community (Playwright + TypeScript)",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:desktop": "playwright test --project=desktop-chrome",
    "test:headed": "playwright test --project=desktop-chrome --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "test:visual": "playwright test --grep @visual",
    "test:visual:update": "playwright test --grep @visual --update-snapshots",
    "lighthouse": "lhci autorun && node scripts/lighthouse-summary.mjs mobile",
    "lighthouse:desktop": "lhci autorun --config=lighthouserc.desktop.json && node scripts/lighthouse-summary.mjs desktop",
    "lighthouse:open": "node scripts/lighthouse-summary.mjs mobile --open",
    "lighthouse:desktop:open": "node scripts/lighthouse-summary.mjs desktop --open",
    "lighthouse:full": "node scripts/lighthouse-full.mjs",
    "lighthouse:full:desktop": "node scripts/lighthouse-full.mjs --device desktop"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
